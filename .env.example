# 实际网关和专用账号 / Your gateway and dedicated RouterOS account.
ROUTEROS_HOST=192.168.88.1
ROUTEROS_USER=network-reader
ROUTEROS_PASSWORD=

# api: 可信内网明文协议 / Plaintext on a trusted LAN or VPN (8728).
# api-ssl: 需要服务证书和 CA / Requires a server certificate and trusted CA (8729).
ROUTEROS_TRANSPORT=api
# 留空使用协议默认端口 / Leave blank for the transport's default port.
ROUTEROS_PORT=

# 独立面板密码，用户名 network / Separate dashboard password; username: network.
NETWORK_ADMIN_PASSWORD=
# Compose 宿主机网页端口 / Host web port for Compose.
NETWORK_WEB_PORT=8080

# 可选：出口与 ICMP 目标 / Optional WAN override and ICMP target.
NETWORK_WAN=
NETWORK_PING_TARGET=223.5.5.5

# API-SSL 自建 CA：只读挂载公开证书 / Mount the public CA certificate read-only.
# ROUTEROS_CA_FILE=/certs/router-ca.crt
# ROUTEROS_SERVER_NAME=router.home.arpa
